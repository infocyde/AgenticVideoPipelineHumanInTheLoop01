# Copy to .env (here or in a parent folder) and fill in what you have. Never commit .env.
# Scripts read env vars first, then .env files from the repo root upwards (scripts/lib/env.ts).
#
# None of these are needed to make an episode. Claude sources footage from keyless archives
# (Wikimedia Commons, Openverse, NASA, Internet Archive) and fact-checks with its own web search.
# Add a key only for the feature next to it.

# Needed only for `npm run generate` (FLUX 3 stills, the fallback when no licensed image exists).
# Without it, missing shots fall back to another asset or the map. https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Needed only for `npm run voice` with engine elevenlabs (the elevenlabs skill). Billed per character.
# Text to Speech permission is enough with voice.elevenlabs.voice_id set; add Voices: Read to use voice names
# and User: Read to see the quota. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- Optional media-sourcing keys (find-media skill). Each source has a keyless fallback. ---

# DVIDS (US military video/photos API). Create an API account + application: https://api.dvidshub.net
DVIDS_API_KEY=

# Freesound (sfx search + HQ previews; original downloads need OAuth2). https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# api.data.gov key, used for Smithsonian Open Access (CC0). https://api.data.gov/signup/
DATA_GOV_API_KEY=

# Europeana (needs a free Europeana account; request the key in your account). https://pro.europeana.eu/get-api
EUROPEANA_API_KEY=

# Flickr API. https://www.flickr.com/services/apps/create/
FLICKR_API_KEY=

# US National Archives Catalog API v2 (request by email to Catalog_API@nara.gov). https://www.archives.gov/research/catalog/help/api
NARA_API_KEY=
