{
  "name": "brief-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable narrated-countdown video kit (Remotion). One folder of data per episode.",
  "type": "module",
  "scripts": {
    "new": "tsx scripts/new.ts",
    "sync": "tsx scripts/sync.ts",
    "align": "tsx scripts/align.ts",
    "lyrics": "tsx scripts/lyrics.ts",
    "setup:align": "tsx scripts/setup-align.ts",
    "setup:lyrics": "tsx scripts/setup-lyrics.ts",
    "setup:voice": "tsx scripts/setup-voice.ts",
    "setup:music": "tsx scripts/setup-music.ts",
    "setup:image": "tsx scripts/setup-image.ts",
    "compose": "tsx scripts/compose.ts",
    "voice": "tsx scripts/voice.ts",
    "short": "tsx scripts/short.ts",
    "assets": "tsx scripts/assets.ts",
    "generate": "tsx scripts/generate.ts",
    "check": "tsx scripts/check.ts",
    "dev": "tsx scripts/sync.ts && remotion studio",
    "preview": "tsx scripts/preview.ts",
    "render": "tsx scripts/render.ts",
    "master": "tsx scripts/master.ts",
    "thumb": "tsx scripts/thumb.ts",
    "credits": "tsx scripts/credits.ts",
    "kill": "tsx scripts/kill.ts",
    "typecheck": "tsc --noEmit",
    "shot": "tsx scripts/shot.ts",
    "infographic": "tsx scripts/infographic.ts",
    "explainer": "tsx scripts/explainer.ts",
    "sfx": "tsx scripts/sfx.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "d3-geo": "^3.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.536",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "playwright-core": "^1.56.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "yaml": "^2.8.1"
  }
}
